<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.photobooth.controller.PhotoboothController"
            styleClass="single-root"
            prefWidth="1280"
            prefHeight="800">

    <top>
        <AnchorPane style="-fx-padding: 10;">
            <Button onAction="#toggleMusic" style="-fx-background-color: transparent; -fx-padding: 0; -fx-background-radius: 50%; -fx-min-width: 40px; -fx-min-height: 40px; -fx-max-width: 40px; -fx-max-height: 40px;" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="20">
                <graphic>
                    <StackPane alignment="CENTER">
                        <Circle radius="20" style="-fx-fill: #e5667c;"/>
                        <ImageView fx:id="soundIcon" fitWidth="20" fitHeight="20" preserveRatio="true"/>
                    </StackPane>
                </graphic>
            </Button>
        </AnchorPane>
    </top>

    <center>
        <StackPane alignment="CENTER" style="-fx-translate-y: -20;">

            <HBox alignment="CENTER" spacing="80" styleClass="main-container">

                    <StackPane alignment="CENTER" styleClass="camera-container" style="-fx-background-radius: 35; -fx-min-width: 850; -fx-min-height: 650; -fx-max-width: 850; -fx-max-height: 650;">

                    <StackPane styleClass="camera-frame">
                        <StackPane styleClass="camera-preview-container">
                            <ImageView fx:id="webcamView"
                                       fitWidth="850"
                                       fitHeight="650"
                                       preserveRatio="false">
                                <clip>
                                    <Rectangle arcWidth="35" arcHeight="35" width="850" height="650"/>
                                </clip>
                            </ImageView>
                            
                          
                            <StackPane fx:id="cameraInitializingPane" 
                                      styleClass="camera-initializing"
                                      visible="false"
                                      alignment="CENTER">
                                <Label text="Initializing Camera..." 
                                       styleClass="camera-initializing-text loading-dots"/>
                            </StackPane>

                            <StackPane fx:id="permissionOverlayPane"
                                      styleClass="permission-overlay"
                                      visible="false"
                                      alignment="CENTER">
                                <VBox alignment="CENTER" spacing="20">
                                    <Label text="📷" styleClass="permission-overlay-icon"/>
                                    <Label text="Camera Permission Required" styleClass="permission-overlay-title"/>
                                    <Label text="Click 'Allow' in the permission dialog to continue"
                                           styleClass="permission-overlay-message"/>
                                </VBox>
                            </StackPane>
                           
                            
                        </StackPane>

                        <Pane fx:id="flashOverlay" styleClass="camera-flash"
                              prefWidth="850" prefHeight="650"/>

                        <Pane styleClass="camera-overlay">
                            <Rectangle fx:id="landscapeGuide"
                                       styleClass="landscape-guide"
                                       width="850"
                                       height="650"
                                       translateX="0"
                                       translateY="0"
                                       arcWidth="35"
                                       arcHeight="35"
                                       fill="transparent"/>
                            <Label fx:id="timerLabel"
                                   text=""
                                   styleClass="countdown"/>
                        </Pane>

                        <StackPane fx:id="photoPreviewPane"
                                   visible="false"
                                   styleClass="preview-pane">
                            <ImageView fx:id="previewView"
                                       fitWidth="860"
                                       fitHeight="640"
                                       preserveRatio="false"/>
                        </StackPane>

                    </StackPane>

                    <VBox alignment="CENTER" spacing="8" styleClass="smartphone-capture-container">
                        <Button fx:id="captureButton"
                                onAction="#capturePhoto"
                                styleClass="smartphone-capture-button">
                            <graphic>
                                <StackPane alignment="CENTER">
                                    <Circle radius="35" styleClass="smartphone-capture-outer"/>
                                    <Circle radius="25" styleClass="smartphone-capture-inner"/>
                                </StackPane>
                            </graphic>
                        </Button>
                        <Label fx:id="modeLabel" text="PHOTO" styleClass="capture-mode-indicator"/>
                    </VBox>

                </StackPane>

                <ScrollPane styleClass="controls-panel" fitToWidth="true">
                    <VBox alignment="TOP_CENTER" spacing="20">
                        <Label text="Filters" styleClass="controls-title"/>
                        <ChoiceBox fx:id="filterChoiceBox" styleClass="choice-box" prefWidth="200"/>

                        <Label text="Distortion" styleClass="controls-title"/>
                        <ChoiceBox fx:id="distortionChoiceBox" styleClass="choice-box" prefWidth="200"/>

                        <Label text="Layout" styleClass="controls-title"/>
                        <ChoiceBox fx:id="layoutChoiceBox" styleClass="choice-box" prefWidth="200"/>

                        <Label text="Timer" styleClass="controls-title"/>
                        <ChoiceBox fx:id="timerChoiceBox" styleClass="choice-box" prefWidth="200"/>



                        <Button fx:id="saveButton"
                                onAction="#saveStrip"
                                text="SAVE STRIP"
                                disable="true"
                                styleClass="side-button"/>

                        <ImageView fx:id="stripView"
                                   fitWidth="250"
                                   preserveRatio="true"
                                   onMouseClicked="#showPreviewPopup"
                                   styleClass="strip-preview"/>
                    </VBox>
                </ScrollPane>

            </HBox>
        </StackPane>
    </center>

</BorderPane>